# ---------------------------------------------------------------- 憑證
# 絕對不能進版控。就算之後 commit 掉，git 歷史裡還是查得到。
finmind_token.txt
*token*.txt
.env
*.key
*.pem

# ---------------------------------------------------------------- 資料
# 資料是跑出來的，不是原始碼。而且 data/prices/twstock_wide.csv 有 252MB，
# 超過 GitHub 單檔 100MB 上限，加進去會讓 push 直接被退回。
data/
*.csv
*.csv.gz

# ---------------------------------------------------------------- 每日產出
# output/ 每天都會重新生成，進版控只會製造無意義的 diff。
# 例外：docs/sample_dashboard.html 是刻意凍結的展示用快照（已移除個人持股）。
output/
logs/

# ---------------------------------------------------------------- 個人資料
# 持股、成交價、部位大小是私人財務資料，不該公開。
portfolio/

# ---------------------------------------------------------------- 雜項
__pycache__/
*.py[cod]
*.zip
*.url
*.bak
*.bak_*
_pc_backup_*/
.DS_Store
Thumbs.db
.venv/
venv/
.idea/
.vscode/

# ---------------------------------------------------------------- 要保留的例外
# .gitignore 的規則是後面覆蓋前面，所以這些 ! 一定要放在最後面。
!.gitignore
!docs/
!docs/**
